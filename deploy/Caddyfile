# TLS from /tls/cert.pem + key.pem – prepared at every start by the `tls` service from the files .env
# points to (default: a self-signed pair; your own PEM pair or a PKCS#12 file) – or set in Settings, which the app
# applies live through the admin API. No ACME, no internal CA.
{
	# Admin API only on a unix socket in a volume that just the app and tls-watch share (no TCP listener anywhere);
	# the app's uid needs write access to connect, the volume confines it.
	admin unix//run/caddy-admin/admin.sock|0666
	# Clients send no SNI when connecting by IP address.
	default_sni {$DEFAULT_SNI}
	auto_https off
}
{$SITE_ADDRESSES} {
	tls /tls/cert.pem /tls/key.pem
	encode zstd gzip
	header -Server
	reverse_proxy app:8000
}

# Plain HTTP only redirects to HTTPS, and only for the configured host names (no open redirect).
http:// {
	header -Server
	@known host {$SITE_HOSTS}
	# 302, not 308: browsers cache permanent redirects, and the HTTPS port is configurable.
	redir @known https://{host}{$HTTPS_SUFFIX}{uri} 302
	respond "Unknown host name – use one of the configured addresses." 404
}
